# Copy this file to .env and fill in your real keys.
# .env is gitignored and must never be committed.

# --- Required ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
TAVILY_API_KEY=tvly-your-key-here

# --- Model routing (cost control) ---
# Cheap model for high-volume calls (planning, extraction).
MODEL_FAST=claude-haiku-4-5
# Stronger model for synthesis + verification where quality matters.
MODEL_SMART=claude-sonnet-5

# --- Budget guards (the agent refuses to exceed these per run) ---
MAX_STEPS=25
MAX_SOURCES=15
RUN_TIMEOUT_SECONDS=300

# --- Storage ---
DATABASE_URL=sqlite:///data/research.db
REPORTS_DIR=reports

# --- Observability (optional; leave blank to disable tracing) ---
# Get these from https://cloud.langfuse.com (free tier) if you want traces.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
